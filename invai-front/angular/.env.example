# Copy this file to .env and fill in valid test credentials for the IdP login (idp.caib.es)
# used by the Playwright e2e auth setup (e2e/auth.setup.ts).
E2E_USERNAME=
E2E_PASSWORD=

# Credentials for the Soffid SCIM API used by scripts/soffid-*.ps1.
# Optional full Basic header; takes precedence over SOFFID_USER/SOFFID_PASS.
SOFFID_AUTHORIZATION=
SOFFID_USER=
SOFFID_PASS=
