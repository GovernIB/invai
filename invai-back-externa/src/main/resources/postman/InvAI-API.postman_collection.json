  "item": [
    {
      "name": "00 - Public (externa)",
      "item": [
        {
          "name": "Config - Get login URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionCookie}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/externa/config/url",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "externa",
                "config",
                "url"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "pm.test(\"Response contains the assembled login url\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.url).to.be.a(\"string\");",
                  "    pm.expect(jsonData.url).to.include(\"auth/login\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Redirect to Soffid",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionCookie}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/externa/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "externa",
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve un HTTP 302 hacia /invaiapi/interna/oauth2/authorization/soffid. Se recomienda abrir en el navegador en lugar de Postman para completar el flujo OIDC."
          },
          "response": [],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 302 (redirect to Soffid)\", function () {",
                  "    pm.response.to.have.status(302);",
                  "});",
                  "pm.test(\"Location header points to the Soffid OAuth2 authorization endpoint\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"oauth2/authorization/soffid\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
